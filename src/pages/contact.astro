---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { company } from '../data/company';

/*
 * Deliberately no contact <form>. A form that only fakes a success message
 * (as the current KinSentry contact page does) is worse than no form: it
 * silently drops real messages. Plain mailto: links are honest and work.
 * If a form is wanted later, wire it to a real endpoint first.
 */
const channels = [
  {
    label: 'New projects and partnerships',
    email: company.email.general,
    note: 'Project enquiries and estimates, partnerships, press.',
  },
  {
    label: 'General enquiries',
    email: company.email.contact,
    note: 'Anything else — questions, feedback, or just to say hello.',
  },
  {
    label: 'Security disclosure',
    email: company.email.security,
    note: 'Vulnerabilities and responsible disclosure.',
  },
];
---

<Base
  heroNav
  title="Contact"
  description="Get in touch with KCNEX Innovations — project enquiries, partnerships, product support, and security disclosure."
>
  <PageHeader
    eyebrow="Contact"
    title="Talk to a person"
    lede="Every address below reaches the people who build the software. Pick whichever fits — we would rather you send it to the wrong one than not send it."
  />

  <section class="section">
    <div class="container">
      <ul class="channels">
        {
          channels.map((channel) => (
            <li class="channel" data-reveal data-tilt>
              <div class="channel__glow" aria-hidden="true" />
              <h2 class="channel-label">{channel.label}</h2>
              <a class="channel-email" href={`mailto:${channel.email}`}>
                {channel.email}
              </a>
              <p class="channel-note">{channel.note}</p>
            </li>
          ))
        }
      </ul>

      <div class="detail-block" data-reveal>
        <h2 class="detail-title">Company details</h2>
        <dl class="details">
          <div>
            <dt>Legal entity</dt>
            <dd>{company.legalEntity}</dd>
          </div>
          <div>
            <dt>Built in</dt>
            <dd>{company.builtIn}</dd>
          </div>
          <div>
            <dt>Serving</dt>
            <dd>{company.serves.join(', ')}</dd>
          </div>
          {
            company.address && (
              <div>
                <dt>Address</dt>
                <dd>{company.address}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .channels {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }

  .channel {
    position: relative;
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 26px;
  }
  .channel:hover {
    border-color: var(--primary);
    box-shadow: var(--depth-shadow-hover);
  }

  .channel__glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(
      220px circle at var(--mx, 50%) var(--my, 0%),
      var(--glow), transparent 70%
    );
    transition: opacity var(--dur) var(--ease);
    pointer-events: none;
  }
  .channel:hover .channel__glow { opacity: 1; }

  .channel-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 12px;
  }

  .channel-email {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 19px;
    color: var(--primary);
    text-decoration: none;
    word-break: break-word;
  }
  .channel-email:hover { text-decoration: underline; }

  .channel-note {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--muted-foreground);
  }

  .detail-block {
    margin-top: 40px;
    padding: 30px;
    border-radius: var(--radius-lg);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    box-shadow: var(--depth-shadow);
  }

  .detail-title {
    font-size: 22px;
    margin-bottom: 20px;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 20px;
    margin: 0;
  }

  dt {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 5px;
  }

  dd {
    margin: 0;
    font-size: 16px;
    color: var(--foreground);
  }
</style>
