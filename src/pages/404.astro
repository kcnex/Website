---
import Base from '../layouts/Base.astro';
import Hero3D from '../components/Hero3D.astro';
---

<Base
  heroNav
  title="Page not found"
  description="That page does not exist on the KCNEX Innovations website."
>
  <section class="section notfound">
    <Hero3D />
    <div class="container nf-inner">
      <p class="nf-eyebrow" data-reveal>Error 404</p>
      <h1 class="nf-title" data-reveal>That page isn't here</h1>
      <p class="nf-body" data-reveal>
        The link may be out of date, or we may have moved something. Neither is
        your fault.
      </p>
      <div class="nf-actions" data-reveal>
        <a class="btn btn-primary btn-glow" href="/">Back to home</a>
        <a class="btn btn-ghost" href="/contact">Tell us about the link</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    position: relative;
    isolation: isolate;
    margin-top: calc(-1 * var(--nav-h));
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: calc(var(--nav-h) + 6vh) 10vh;
    overflow: hidden;
  }

  .nf-inner {
    position: relative;
    z-index: 1;
  }

  .nf-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hero-accent);
    margin-bottom: 14px;
  }

  .nf-title {
    color: var(--hero-fg);
    font-size: clamp(40px, 8vw, 88px);
    line-height: 1.03;
    margin-bottom: 18px;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.4);
  }

  .nf-body {
    color: var(--hero-muted);
    font-size: clamp(17px, 2vw, 21px);
    max-width: 52ch;
    margin-bottom: 32px;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* Ghost + glow buttons for the dark stage (mirrors the homepage hero). */
  .btn-ghost {
    background: rgba(255, 255, 255, 0.06);
    color: var(--hero-fg);
    border-color: var(--hero-border);
    backdrop-filter: blur(6px);
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--hero-fg);
    border-color: rgba(245, 246, 248, 0.4);
  }
  .btn-glow { box-shadow: 0 8px 30px -6px var(--glow-strong); }
</style>
