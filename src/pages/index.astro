---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Hero3D from '../components/Hero3D.astro';
import { products } from '../data/products';
import { company, services } from '../data/company';

const pipeline = [
  { n: '01', word: 'Develop', body: 'We write the software — apps, web, and the systems behind them.' },
  { n: '02', word: 'Deploy', body: 'We ship it and keep it running: pipelines, cloud, monitoring.' },
  { n: '03', word: 'Grow', body: 'We bring the customers — SEO, campaigns, and measured growth.' },
];
---

<Base
  heroNav
  title="Develop. Deploy. Grow."
  description="KCNEX Innovations is a software development studio: software and app development, website and web app design and development, DevOps, and digital marketing — from code to customers."
>
  <!-- 1. Immersive 3D hero -->
  <section class="section hero">
    <Hero3D />
    <div class="container hero-inner">
      <p class="hero-badge" data-reveal>
        <span class="hero-badge__dot"></span>
        Software studio · Built in {company.builtIn} · Serving {company.serves.join(', ')}
      </p>
      <h1 class="hero-title" data-reveal>
        Develop. Deploy. <span class="grad">Grow.</span>
      </h1>
      <p class="hero-lede" data-reveal>
        KCNEX takes products from the first line of code to real customers —
        software and app development, websites and web apps, DevOps, and
        digital marketing, under one roof.
      </p>
      <div class="hero-actions" data-reveal>
        <a class="btn btn-primary btn-glow" href="#services">See what we do</a>
        <a class="btn btn-ghost" href="/contact">Start a project</a>
      </div>
    </div>
    <a class="hero-scroll" href="#pipeline" aria-label="Scroll to content">
      <span class="hero-scroll__mouse"></span>
    </a>
  </section>

  <!-- 2. Develop → Deploy → Grow pipeline -->
  <section class="section pipeline" id="pipeline">
    <div class="container">
      <ol class="pipe-grid">
        {
          pipeline.map((step) => (
            <li class="pipe-card" data-reveal data-tilt>
              <span class="pipe-num">{step.n}</span>
              <h2 class="pipe-word">{step.word}</h2>
              <p class="pipe-body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 3. Services grid -->
  <section class="section band-alt" id="services">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Services</p>
        <h2 class="section-title">What we do</h2>
        <p class="prose">
          Four disciplines, one team. Most projects use more than one — that is
          the point.
        </p>
      </div>

      <div class="service-grid">
        {
          services.map((service, i) => (
            <article class="service-card" data-reveal data-tilt style={`--i:${i}`}>
              <div class="service-glow" aria-hidden="true" />
              <span class="service-index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="service-title">{service.title}</h3>
              <p class="service-summary">{service.summary}</p>
              <ul class="service-points">
                {service.points.map((point) => (
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                      <path
                        d="m9 6 6 6-6 6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Products grid -->
  <section class="section" id="products">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Products</p>
        <h2 class="section-title">What we have shipped for ourselves</h2>
        <p class="prose">
          Alongside client work we build our own products, end to end — the
          same way we build for clients. Everything we ship is listed here.
        </p>
      </div>

      <div class="product-grid" data-count={products.length}>
        {products.map((product) => (
          <div data-reveal><ProductCard product={product} /></div>
        ))}

        <article class="card-next" data-reveal>
          <h3 class="next-title">More in development</h3>
          <p class="next-body">
            We are deliberate about what we ship. New products appear here when
            they are real enough to try — not before.
          </p>
          <a class="next-link" href={`mailto:${company.email.general}`}>
            Tell us what to build next
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- 5. Mission / principles -->
  <section class="section band-deep principles-band">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How we work</p>
        <h2 class="section-title">Four commitments</h2>
      </div>

      <ol class="principles">
        <li data-reveal>
          <span class="principle-num">01</span>
          <h3 class="principle-title">One team, end to end</h3>
          <p class="principle-body">
            The people who write the code set up the pipelines and run the
            launch. Develop, deploy, grow — nothing gets lost in handovers
            between vendors.
          </p>
        </li>
        <li data-reveal>
          <span class="principle-num">02</span>
          <h3 class="principle-title">Build for the person using it</h3>
          <p class="principle-body">
            If a product only works when the user is technical, careful, and
            unhurried, it does not work. We build for real people on their
            worst day, not demo audiences.
          </p>
        </li>
        <li data-reveal>
          <span class="principle-num">03</span>
          <h3 class="principle-title">Say only what is true</h3>
          <p class="principle-body">
            No invented user counts, no borrowed logos, no padded case studies.
            A claim on this site is one we can show you the basis for.
          </p>
        </li>
        <li data-reveal>
          <span class="principle-num">04</span>
          <h3 class="principle-title">Answer when something breaks</h3>
          <p class="principle-body">
            A real inbox, monitored by the people who wrote the code. Reports of
            problems get a response, not a form.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 6. Contact CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-panel" data-reveal>
        <div class="cta-panel__glow" aria-hidden="true"></div>
        <h2 class="cta-title">Have a project in mind?</h2>
        <p class="prose cta-body">
          Tell us what you want to build — or what you are stuck with. You will
          get an honest assessment from the people who would do the work, not a
          sales deck.
        </p>
        <div class="hero-actions cta-actions">
          <a class="btn btn-primary btn-glow" href="/contact">Start a project</a>
          <a class="btn btn-secondary" href="#products">See what we ship</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Scroll-reveal: fade/rise elements as they enter. Respects reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: '0px 0px -8% 0px' }
    );
    items.forEach((el) => io.observe(el));
  }

  // Pointer tilt for depth cards — precise pointers only, motion allowed only.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (fine && !reduce) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      const MAX = 7;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        card.style.setProperty('--ry', `${px * MAX}deg`);
        card.style.setProperty('--rx', `${-py * MAX}deg`);
        card.style.setProperty('--mx', `${(px + 0.5) * 100}%`);
        card.style.setProperty('--my', `${(py + 0.5) * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--ry', '0deg');
        card.style.setProperty('--rx', '0deg');
      });
    });
  }
</script>

<style>
  /* ── Reveal primitive ─────────────────────────────────────── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    will-change: opacity, transform;
  }
  [data-reveal].in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }

  /* ── 1. Hero ──────────────────────────────────────────────── */
  .hero {
    position: relative;
    isolation: isolate;
    /* Slide up under the transparent sticky nav so the 3D fills the top. */
    margin-top: calc(-1 * var(--nav-h));
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: calc(var(--nav-h) + 6vh) 12vh;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 15px 7px 12px;
    border: 1px solid var(--hero-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    color: var(--hero-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    margin-bottom: 26px;
  }
  .hero-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--logo-accent);
    box-shadow: 0 0 0 4px rgba(250, 93, 19, 0.18);
    animation: pulse 2.6s var(--ease) infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(250, 93, 19, 0.22); }
    50% { box-shadow: 0 0 0 7px rgba(250, 93, 19, 0.04); }
  }

  .hero-title {
    color: var(--hero-fg);
    font-size: clamp(46px, 9vw, 104px);
    line-height: 1.02;
    max-width: 15ch;
    margin-bottom: 26px;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.4);
  }
  .hero-title .grad {
    background: linear-gradient(105deg, #ff8a4d 0%, #fa5d13 50%, #ffb489 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    color: var(--hero-muted);
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.6;
    max-width: 60ch;
    margin-bottom: 36px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* Ghost button for the dark stage. */
  .btn-ghost {
    background: rgba(255, 255, 255, 0.06);
    color: var(--hero-fg);
    border-color: var(--hero-border);
    backdrop-filter: blur(6px);
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--hero-fg);
    border-color: rgba(245, 246, 248, 0.4);
  }

  .btn-glow {
    position: relative;
    box-shadow: 0 8px 30px -6px var(--glow-strong);
  }
  .btn-glow:hover {
    box-shadow: 0 10px 40px -6px var(--glow-strong);
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    z-index: 1;
    width: 26px;
    height: 42px;
    border: 2px solid var(--hero-border);
    border-radius: 14px;
    display: grid;
    justify-items: center;
    padding-top: 7px;
  }
  .hero-scroll__mouse {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--hero-accent);
    animation: scrollcue 1.8s var(--ease) infinite;
  }
  @keyframes scrollcue {
    0% { opacity: 0; transform: translateY(-2px); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(12px); }
  }

  /* ── 2. Pipeline ──────────────────────────────────────────── */
  .pipeline {
    padding-block: clamp(56px, 8vw, 96px);
  }
  .pipe-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .pipe-card {
    position: relative;
    padding: 30px 28px;
    border-radius: var(--radius-lg);
    background: var(--glass);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(14px);
    box-shadow: var(--depth-shadow);
    transform: perspective(900px) rotateX(var(--rx, 0)) rotateY(var(--ry, 0));
    transform-style: preserve-3d;
    transition: transform 0.2s var(--ease), box-shadow var(--dur) var(--ease);
  }
  .pipe-card:hover { box-shadow: var(--depth-shadow-hover); }
  .pipe-num {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--primary);
    letter-spacing: 0.1em;
  }
  .pipe-word {
    font-size: clamp(26px, 3vw, 34px);
    margin: 8px 0 10px;
  }
  .pipe-body {
    font-size: 15px;
    color: var(--muted-foreground);
    line-height: 1.55;
  }
  @media (max-width: 760px) {
    .pipe-grid { grid-template-columns: 1fr; }
  }

  /* ── Shared section heads ─────────────────────────────────── */
  .section-head { margin-bottom: 44px; }
  .section-title {
    font-size: clamp(30px, 4.4vw, 46px);
    margin-bottom: 16px;
  }

  /* ── 3. Services (glass tilt cards) ───────────────────────── */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    align-items: stretch;
  }
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    overflow: hidden;
    transform: perspective(900px) rotateX(var(--rx, 0)) rotateY(var(--ry, 0));
    transform-style: preserve-3d;
    transition: transform 0.2s var(--ease),
                border-color var(--dur) var(--ease),
                box-shadow var(--dur) var(--ease);
  }
  .service-card:hover {
    border-color: var(--primary);
    box-shadow: var(--depth-shadow-hover);
  }
  /* Cursor-following orange glow inside the card. */
  .service-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(
      220px circle at var(--mx, 50%) var(--my, 0%),
      var(--glow), transparent 70%
    );
    transition: opacity var(--dur) var(--ease);
    pointer-events: none;
  }
  .service-card:hover .service-glow { opacity: 1; }
  .service-index {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--muted-foreground);
    margin-bottom: 14px;
  }
  .service-title {
    font-size: 22px;
    margin-bottom: 10px;
  }
  .service-summary {
    font-size: 14.5px;
    color: var(--muted-foreground);
    margin-bottom: 18px;
  }
  .service-points {
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .service-points li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px;
    color: var(--muted-foreground);
    line-height: 1.5;
  }
  .service-points svg {
    color: var(--primary);
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* ── 4. Products ──────────────────────────────────────────── */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
    align-items: stretch;
  }
  .product-grid[data-count='1'] {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    max-width: 900px;
  }
  .product-grid > [data-reveal] { display: flex; }
  .product-grid > [data-reveal] > :global(*) { width: 100%; }
  .card-next {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 28px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background: transparent;
  }
  .next-title {
    font-size: 20px;
    color: var(--muted-foreground);
    margin-bottom: 10px;
  }
  .next-body {
    font-size: 14.5px;
    color: var(--muted-foreground);
    margin-bottom: 16px;
  }
  .next-link {
    font-size: 15px;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
    align-self: flex-start;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .next-link:hover { text-decoration: underline; }

  /* ── 5. Principles ────────────────────────────────────────── */
  .principles-band {
    position: relative;
    overflow: hidden;
  }
  .principles-band::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 46vw;
    height: 46vw;
    background: radial-gradient(circle, var(--glow-strong), transparent 62%);
    opacity: 0.4;
    pointer-events: none;
  }
  .principles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 36px 32px;
  }
  .principle-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--band-accent);
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }
  .principle-title {
    font-size: 21px;
    margin-bottom: 10px;
  }
  .principle-body {
    font-size: 15px;
    color: var(--band-muted);
    line-height: 1.6;
  }

  /* ── 6. CTA panel ─────────────────────────────────────────── */
  .cta-panel {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: clamp(40px, 6vw, 72px);
    border-radius: calc(var(--radius-lg) + 6px);
    background: var(--card);
    border: 1px solid var(--border);
    box-shadow: var(--depth-shadow);
  }
  .cta-panel__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 80% at 50% -10%, var(--glow), transparent 60%),
      radial-gradient(50% 60% at 90% 120%, rgba(120, 150, 220, 0.12), transparent 60%);
    pointer-events: none;
  }
  .cta-panel > * { position: relative; }
  .cta-title {
    font-size: clamp(28px, 4vw, 44px);
    margin-bottom: 14px;
  }
  .cta-body {
    margin-inline: auto;
    margin-bottom: 28px;
  }
  .cta-actions { justify-content: center; }
</style>
