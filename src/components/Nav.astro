---
import Logo from './Logo.astro';
import { company, navLinks } from '../data/company';

interface Props {
  /* When true, the nav floats transparent over a dark hero and goes solid on
     scroll. Set on pages whose first section is the dark 3D stage. */
  heroNav?: boolean;
}
const { heroNav = false } = Astro.props;
const path = Astro.url.pathname;
---

<header class="nav" data-hero={heroNav ? '' : undefined}>
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${company.name} — home`}>
      <Logo size={28} />
      <span class="brand-text">
        <span class="brand-name">KCNEX</span>
        <span class="brand-suffix">Innovations</span>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Solidify the hero nav once the page scrolls off the top.
  const nav = document.querySelector<HTMLElement>('.nav[data-hero]');
  if (nav) {
    const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 12);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--nav-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    transition: background-color var(--dur) var(--ease),
                border-color var(--dur) var(--ease);
  }

  /* Over the dark 3D hero: float transparent with light text until scrolled. */
  .nav[data-hero]:not(.is-scrolled) {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }
  .nav[data-hero]:not(.is-scrolled) .brand { color: var(--hero-fg); }
  .nav[data-hero]:not(.is-scrolled) .brand-suffix { color: var(--hero-muted); }
  .nav[data-hero]:not(.is-scrolled) .nav-links a { color: var(--hero-muted); }
  .nav[data-hero]:not(.is-scrolled) .nav-links a:hover {
    color: var(--hero-fg);
    background: rgba(255, 255, 255, 0.1);
  }
  .nav[data-hero]:not(.is-scrolled) .nav-links a[aria-current='page'] {
    color: var(--hero-accent);
  }
  /* The Logo ink is white over the dark hero. */
  .nav[data-hero]:not(.is-scrolled) :global(svg path:first-child) {
    fill: var(--hero-fg);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    /* 44px min touch target — the 28px mark alone is too small to tap. */
    min-height: 44px;
    text-decoration: none;
    color: var(--foreground);
  }

  .brand-text {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }

  .brand-name {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 0.02em;
  }

  .brand-suffix {
    font-family: var(--font-serif);
    font-size: 15px;
    font-style: italic;
    color: var(--muted-foreground);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 13px;
    border-radius: var(--radius);
    font-size: 15px;
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--dur) var(--ease),
                background-color var(--dur) var(--ease);
  }

  .nav-links a:hover {
    color: var(--foreground);
    background: var(--accent);
  }

  .nav-links a[aria-current='page'] {
    color: var(--primary);
    font-weight: 600;
  }

  /* Below 640px the brand suffix and label set would crowd; drop the
     suffix and let the links wrap to their own centred row. */
  @media (max-width: 640px) {
    .nav-inner {
      flex-direction: column;
      gap: 0;
      padding-block: 10px;
    }

    .brand-suffix {
      display: none;
    }

    .nav-links {
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-links a {
      padding: 0 10px;
      font-size: 14px;
    }
  }
</style>
