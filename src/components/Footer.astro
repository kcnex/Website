---
import Logo from './Logo.astro';
import { company } from '../data/company';
import { products } from '../data/products';

const year = new Date().getFullYear();
---

<footer class="footer band-deep">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <Logo size={26} onBand />
          <span class="footer-name">KCNEX Innovations</span>
        </div>
        <p class="footer-blurb">{company.tagline}</p>
      </div>

      <div>
        <h2 class="footer-heading">Products</h2>
        <ul>
          {
            products.map((product) => (
              <li>
                {product.url ? (
                  <a href={product.url}>{product.name}</a>
                ) : (
                  <span class="footer-muted">{product.name}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Company</h2>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/security">Security</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Legal</h2>
        <ul>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p>&copy; {year} {company.legalEntity}. All rights reserved.</p>
      <p class="footer-muted">Built in {company.builtIn}.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(48px, 6vw, 72px) 32px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px 24px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
  }

  .footer-name {
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.02em;
  }

  .footer-blurb {
    font-size: 15px;
    color: var(--band-muted);
    max-width: 34ch;
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--band-muted);
    margin-bottom: 14px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  li a,
  .footer-muted {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    font-size: 15px;
    text-decoration: none;
  }

  /* Touch pointers and narrow screens need the full 44px; a precise mouse on a
     wide screen does not, so the desktop footer stays visually tight (34px
     still clears the WCAG 2.5.8 AA minimum of 24px). */
  @media (pointer: coarse), (max-width: 640px) {
    li a,
    .footer-muted {
      min-height: 44px;
    }
  }

  li a {
    color: var(--band-foreground);
    transition: color var(--dur) var(--ease);
  }

  li a:hover {
    color: var(--band-accent);
    text-decoration: underline;
  }

  .footer-muted {
    color: var(--band-muted);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--band-border);
    font-size: 14px;
    color: var(--band-muted);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
