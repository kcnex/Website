---
/*
 * KCNEX mark: two ink chevrons and one accent chevron, pointing forward.
 * Exact vectors from the brand logo (Logo Variations/SVG/kcnex-icon-*.svg).
 *
 * Colours are tokens, not literals: the ink flips between modes (black on
 * light, white on dark) while the accent stays brand orange. The mark is a
 * brand graphic, not text — WCAG 1.4.3 does not apply to logotypes, so the
 * accent may sit below 4.5:1 on the page background by design.
 *
 * `onBand` is for the emphasis band (footer), which is dark in BOTH modes,
 * so the ink pins to the band foreground instead of flipping.
 *
 * `size` is the rendered HEIGHT; width follows the mark's 1.487 aspect.
 * Keep in sync with public/favicon.svg.
 */
interface Props {
  size?: number;
  onBand?: boolean;
}
const { size = 26, onBand = false } = Astro.props;

const width = Math.round(size * 1.487 * 10) / 10;
const ink = onBand ? 'var(--band-foreground)' : 'var(--logo-ink)';
const accent = 'var(--logo-accent)';
---

<svg
  width={width}
  height={size}
  viewBox="0 0 315.3 212.1"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path fill={ink} fill-rule="evenodd" d="M138.8 211.9 43.7 111.7 43.0 110.7 42.7 109.6 42.8 108.6 44.0 106.6 140.1 0.4 100.1 0.1 97.0 0.7 95.2 1.4 93.5 2.5 91.2 4.6 2.3 103.0 1.0 104.9 0.0 107.9 0.0 109.9 0.7 112.8 2.1 115.7 4.7 119.1 87.8 207.0 90.8 209.8 92.6 210.8 94.5 211.6 97.6 212.0 138.8 211.9Z M253.7 211.8 159.9 110.4 158.7 108.6 158.5 107.7 158.6 106.7 159.2 105.7 254.3 0.5 239.8 0.0 213.4 0.2 211.5 0.5 209.5 1.2 207.0 2.9 120.0 98.8 118.2 101.2 116.8 104.0 116.0 107.0 115.9 109.0 116.7 111.8 117.9 113.5 202.4 206.5 204.7 208.7 206.4 210.0 209.1 211.4 212.4 212.0 253.7 211.8Z" />
  <path fill={accent} fill-rule="evenodd" d="M267.5 161.2 313.2 116.5 314.4 114.8 315.1 113.0 315.3 111.1 315.2 109.2 314.8 107.3 314.1 105.4 312.6 102.8 310.6 100.5 265.7 55.9 263.9 54.9 262.9 54.7 261.0 54.8 260.0 55.3 247.4 68.1 246.2 70.1 245.9 72.0 246.3 73.9 247.4 75.7 279.7 109.1 247.1 141.8 246.3 142.8 246.0 143.8 246.2 145.8 247.9 148.6 261.0 161.7 262.8 162.6 264.7 162.8 266.6 162.0 267.5 161.2Z" />
</svg>

