---
/*
 * KCNEX mark: a "K" cut from a keystone block.
 *
 * The K is stroked rather than filled so the arms stay optically even with the
 * stem at any size. Keep this in sync with public/favicon.svg.
 *
 * Colours are tokens, not literals, because the block inverts between light and
 * dark mode and the mark has to invert with it. --primary on the light-mode
 * block is only 2.33:1, so the mark uses --chart-2 there instead.
 *
 * `onBand` is for the emphasis band (footer), where the block is light in BOTH
 * modes and so the mark stays the dark blue.
 */
interface Props {
  size?: number;
  onBand?: boolean;
}
const { size = 30, onBand = false } = Astro.props;

const block = onBand ? 'var(--band-foreground)' : 'var(--logo-block)';
const mark = onBand ? 'var(--logo-mark-on-light)' : 'var(--logo-mark)';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M3 2.5h18v13.2c0 .55-.27 1.07-.72 1.39L12.58 22.6a1 1 0 0 1-1.16 0L3.72 17.09A1.7 1.7 0 0 1 3 15.7V2.5Z"
    fill={block}
  />
  <g
    stroke={mark}
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  >
    <path d="M9.7 8.4V15.6" />
    <path d="M14.8 8.4 10.4 12l4.4 3.6" />
  </g>
</svg>
